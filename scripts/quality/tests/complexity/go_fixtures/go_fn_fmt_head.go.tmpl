// Fixture head for the formatting-only scenario: the same FmtOne/FmtTwo
// bodies after gofmt plus inserted blank lines and reflowed statements.
// The canonical body hash is computed over the AST printed against a
// synthetic single-line file set, so whitespace-only edits keep the hash
// stable: zero changed functions, both bodies remain untouched.
func FmtOne(x int) int {
	n := 0

	if x > 0 {
		n = n + 1
	}

	if x > 1 {
		n = n + 2
	}

	if x > 2 {

		n = n + 3
	}
	return n
}

func FmtTwo(xs []int) int {
	total := 0

	for _, x := range xs {
		if x%2 == 0 {
			total += x
		}
	}
	return total
}
