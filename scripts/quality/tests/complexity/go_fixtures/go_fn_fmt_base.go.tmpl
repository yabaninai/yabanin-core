// Fixture base for the formatting-only scenario: valid Go that gofmt would
// rewrite (odd spaces, single-line ifs). Head applies gofmt plus blank
// lines. FmtOne cyclomatic 4 = 1 + 3 ifs, FmtTwo cyclomatic 3 = 1 + for +
// if (hand-counted oracles); both are formatting-only changes, so the head
// run must report zero changed functions.
func   FmtOne (x int ) int {
	n:=0
	if x>0 { n=n+1 }
	if x>1 {n=n+2}
	if x>2 {n=n+3}
	return   n
}

func FmtTwo (xs   []int) int {
	total := 0
	for _, x := range xs {
		if x%2 == 0 { total += x }
	}
	return total
}
