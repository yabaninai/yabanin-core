# Yabanin Environment Variables

# Gateway (data-plane)
YABANIN_GATEWAY_LISTEN=:8082
YABANIN_GATEWAY_ADMIN=:9090
YABANIN_PROVIDER_ADDR=localhost:8081
YABANIN_REDIS_ADDR=localhost:6379
YABANIN_PG_URI=postgres://yabanin:yabanin@localhost/yabanin?sslmode=disable
YABANIN_LOG_LEVEL=info

# Logger daemon (consumer-only)
YABANIN_LOGGERD_STREAM=events:queue

# Admin (control-plane)
YABANIN_ADMIN_LISTEN=:8086
YABANIN_ADMIN_DOMAIN=localhost
YABANIN_SESSION_KEY=dev-change-me-in-production-session-key
YABANIN_ENCRYPTION_KEY=dev-change-me-32-byte-enc-key

# Cache HMAC
YABANIN_CACHE_HMAC_SECRET=change-me-in-production-cache-hmac-secret-key
