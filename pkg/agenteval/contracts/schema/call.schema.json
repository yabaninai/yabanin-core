{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent-eval call record",
  "type": "object",
  "additionalProperties": false,
  "required": ["call_id", "episode_id", "root_id", "attempt_index", "arm", "model_requested", "endpoint", "status", "usage", "cost", "latency"],
  "properties": {
    "call_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "root_id": {"type": "string", "minLength": 1},
    "attempt_index": {"type": "integer", "minimum": 0},
    "arm": {"type": "string", "minLength": 1},
    "model_requested": {"type": "string", "minLength": 1},
    "model_actual": {"type": ["string", "null"]},
    "endpoint": {"type": "string"},
    "generation_id": {"type": ["string", "null"]},
    "finish_reason": {"type": ["string", "null"]},
    "status": {"enum": ["ok", "error", "timeout"]},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["tokens_in", "tokens_out", "reasoning_tokens"],
      "properties": {
        "tokens_in": {"type": ["integer", "null"], "minimum": 0},
        "tokens_out": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "cost": {
      "type": "object", "additionalProperties": false,
      "required": ["estimated_usd", "observed_usd", "uncertain"],
      "properties": {
        "estimated_usd": {"type": ["number", "null"], "minimum": 0},
        "observed_usd": {"type": ["number", "null"], "minimum": 0},
        "uncertain": {"type": "boolean"}
      }
    },
    "latency": {
      "type": "object", "additionalProperties": false,
      "required": ["ttft_ms", "total_ms"],
      "properties": {
        "ttft_ms": {"type": ["integer", "null"], "minimum": 0},
        "total_ms": {"type": "integer", "minimum": 0}
      }
    },
    "decision_header": {"type": ["string", "null"]},
    "error": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
    }
  }
}
