model_provider = "yabanin"
model = "gpt"

[model_providers.yabanin]
name = "Yabanin"
base_url = "https://gw.example/v1"
wire_api = "responses"
env_http_headers = { "X-Yabanin-Labels" = "YABANIN_LABELS" }

[model_providers.yabanin.auth]
command = "yb"
args = ["harness", "key", "--tool", "codex"]
refresh_interval_ms = 300000
timeout_ms = 5000
