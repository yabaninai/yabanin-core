# Same hygiene rule as the nested-module build outputs below, extended to
# the loadtest tools: compiled binaries are build outputs, never source.
# The tracked copies (24,371,750 bytes total) are untracked; rebuild from
# source instead:
#   go build ./scripts/loadtest          (cache_loadtest tool)
#   cd scripts/loadtest/matched && go build ./...
#   cd scripts/loadtest/gatewayoverhead && go build ./...
#   cd scripts/loadtest/http && go build ./...
#   cd tests/load/slowmock && go build ./...   (or: docker build tests/load/slowmock)
/scripts/loadtest/loadtest
/tests/load/slowmock/slowmock

