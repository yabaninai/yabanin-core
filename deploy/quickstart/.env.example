# Generated by scripts/quickstart/init-env.sh. Do not commit deploy/quickstart/.env.
# The three YABANIN_* values below are placeholders, not keys.
# Dev placeholder: with YABANIN_ENV=dev a weak session key only warns
# (a strong random secret is generated). In production a weak key refuses startup.
YABANIN_ENV=dev
YABANIN_SESSION_KEY=changeme
YABANIN_CACHE_HMAC_SECRET=changeme
YABANIN_ENCRYPTION_KEY=changeme
QS_MODEL=mock-model
# Literal IP: the gateway egress guard (D-4) waives its reserved-range refusal
# only for exact IP pins; the mock provider is pinned in the compose network.
QS_UPSTREAM_URL=http://10.207.0.9:8081
QS_ADMIN_EMAIL=admin@localhost
