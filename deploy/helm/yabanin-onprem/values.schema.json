{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "gateway": {
      "type": "object",
      "properties": {
        "replicas": {
          "description": "Gateway replica count; R056-03: malformed (non-integer), fractional or <1 values must fail at render time, not render an un-appliable Deployment",
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "description": "N11-P02-T03: gateway container resources (requests+limits both required so scheduling and eviction behave predictably)",
          "$ref": "#/definitions/resources"
        }
      }
    },
    "loggerd": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "ha": {
      "description": "N11-P02-T03: HA placement knobs (same contract as the cloud chart; see deploy/helm/yabanin/HA-TOPOLOGY.md). ha.enabled=true requires >=2 gateway AND admin replicas at render time.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "topology_key": { "type": "string", "minLength": 1 },
        "when_unsatisfiable": {
          "type": "string",
          "enum": ["DoNotSchedule", "ScheduleAnyway"]
        }
      }
    },
    "minReadySeconds": {
      "description": "N11-P02-T03: readiness must hold this long before a RollingUpdate proceeds to the next pod (>=0)",
      "type": "integer",
      "minimum": 0
    },
    "strategy": {
      "type": "object",
      "properties": {
        "rollingUpdate": {
          "type": "object",
          "properties": {
            "maxUnavailable": {
              "description": "Non-negative integer or percentage string (e.g. 25%)",
              "anyOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "string", "pattern": "^[0-9]+%$" }
              ]
            },
            "maxSurge": {
              "description": "Non-negative integer or percentage string (e.g. 25%)",
              "anyOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "string", "pattern": "^[0-9]+%$" }
              ]
            }
          }
        }
      }
    },
    "pdb": {
      "description": "N11-P02-T03: PodDisruptionBudgets for gateway/admin/loggerd. maxUnavailable >= 1 so 1-replica profiles stay drainable (minAvailable: 1 at replicas=1 blocks every voluntary eviction). Bundled postgres/redis deliberately get no PDB (single-replica, non-HA).",
      "type": "object",
      "properties": {
        "gateway": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "maxUnavailable": {
              "anyOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "string", "pattern": "^[0-9]+%$" }
              ]
            }
          }
        },
        "admin": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "maxUnavailable": {
              "anyOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "string", "pattern": "^[0-9]+%$" }
              ]
            }
          }
        },
        "loggerd": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "maxUnavailable": {
              "anyOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "string", "pattern": "^[0-9]+%$" }
              ]
            }
          }
        }
      }
    },
    "probes": {
      "description": "N11-P02-T03: values-driven liveness/readiness/startup probes for every workload; httpGet xor tcpSocket per probe",
      "type": "object",
      "patternProperties": {
        "^(gateway|admin|loggerd|postgres|redis)$": {
          "type": "object",
          "patternProperties": {
            "^(readiness|liveness|startup)$": { "$ref": "#/definitions/probe" }
          }
        }
      }
    },
    "migration": {
      "description": "N11-P02-T03: migration/backup hook jobs — advisory lock tag, wait timeout, job deadline and container resources",
      "type": "object",
      "properties": {
        "lockTag": { "type": "string", "minLength": 1 },
        "waitTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "bundled": {
      "type": "object",
      "properties": {
        "postgres": { "type": "boolean" },
        "redis": { "type": "boolean" }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "storage": { "type": "string", "minLength": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "storage": { "type": "string", "minLength": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "description": "N11-P02-T03 secret injection: set to an operator-managed Secret name; when non-empty the chart does not render -secrets and inline secrets.* values must be empty (render-time fail)",
          "type": "string"
        }
      }
    },
    "kms": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "kekPath": { "type": "string" },
        "existingSecret": { "type": "string" }
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "tokenPath": { "type": "string" },
        "existingSecret": { "type": "string" }
      }
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "httpGet": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "port": { "type": ["integer", "string"], "minimum": 1, "maximum": 65535 }
          }
        },
        "tcpSocket": {
          "type": "object",
          "properties": {
            "port": { "type": ["integer", "string"], "minimum": 1, "maximum": 65535 }
          }
        },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
