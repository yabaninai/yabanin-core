    {
      "title": "OTel Export — Dropped Records (cumulative)",
      "description": "yabanin_otel_logs_dropped_total: request-log records dropped because the bounded export queue was full (backpressure) or during shutdown. Flat line = healthy; any sustained growth means the OTLP collector is unreachable or too slow. Consumer latency is never affected — see docs/observability/otel-export.md.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "yabanin_otel_logs_dropped_total",
          "legendFormat": "dropped records",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "OTel Export — Drop Rate (saturation)",
      "description": "Rate of export-queue drops over 5m. Zero = the sink keeps up. A positive rate is the saturation signal for the export pipeline: sink down, network broken, or backpressure (the queue itself is bounded — memory cannot grow).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(yabanin_otel_logs_dropped_total[5m])",
          "legendFormat": "drops/s (5m)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "title": "Export Health — Drops Last Hour",
      "description": "Export status at a glance: 0 drops over the last hour = healthy export. Any nonzero value means request-log records were discarded instead of exported.",
