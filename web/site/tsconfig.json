{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "react", "@docusaurus/module-type-aliases", "@docusaurus/theme-classic"]
  },
  "include": ["src/", "*.ts"]
}
